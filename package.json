{
  "name": "master-g",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "bench": "node --env-file-if-exists=.env.local --import tsx benchmark/run.ts",
    "bench:models": "node --env-file-if-exists=.env.local --import tsx benchmark/models.ts",
    "test:checker": "tsx scripts/checker-smoke.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:checker && npm run test:cluster && npm run test:decide && npm run test:facts && npm run test:graph",
    "test:cluster": "tsx scripts/cluster-smoke.ts",
    "test:decide": "tsx scripts/decide-smoke.ts",
    "logs": "tsx scripts/logs.ts",
    "test:facts": "tsx scripts/facts-smoke.ts",
    "test:graph": "tsx scripts/graph-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "mathjs": "^15.2.0",
    "next": "16.4.3",
    "perfect-freehand": "^1.2.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
